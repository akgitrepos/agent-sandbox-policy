{
  "name": "@asp/cli",
  "version": "0.1.1-draft",
  "description": "CLI for Agent Sandbox Policy",
  "type": "module",
  "bin": {
    "asp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && node ../../scripts/add-shebang.mjs ./dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asp/core": "workspace:*",
    "@asp/schemas": "workspace:*",
    "@clack/prompts": "^0.10.1",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.0",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "asp",
    "cli",
    "policy"
  ],
  "license": "MIT"
}
